      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف الإدخال «organizer» إلى «mcpServers» في الملف claude_desktop_config.json ثم أعد تشغيل Claude."
          }
        },
        "en": {
          "stringUnit": {
