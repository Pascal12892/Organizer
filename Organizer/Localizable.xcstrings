    "„%@“ gibt es bereits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» موجود بالفعل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” already exists."
          }
        }
      }
    },
    "„%@“ gibt es im Vault noch nicht.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» غير موجود في الخزنة بعد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” doesn’t exist in the vault yet."
          }
        }
      }
    },
    "„%@“ ist ein wiederholter Termin. Das lässt sich nicht rückgängig machen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» موعد متكرر. لا يمكن التراجع عن ذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a repeating event. This can’t be undone."
          }
        }
      }
    },
    "„%@“ ist kein Ordner. Verknüpfen lassen sich nur Ordner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ليس مجلدًا. يمكن ربط المجلدات فقط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a folder. Only folders can be linked."
          }
        }
      }
    },
    "„%@“ konnte nicht geschrieben werden: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت كتابة «%1$@»: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” could not be written: %2$@"
          }
        }
      }
    },
