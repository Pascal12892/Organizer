      }
    },
    "Organizer hat keinen Zugriff mehr auf den Vault. Wähle den Ordner bitte erneut aus.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد لدى Organizer وصول إلى الخزنة. يرجى اختيار المجلد مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizer no longer has access to the vault. Please choose the folder again."
          }
        }
      }
    },
    "Organizer legt den Ordner direkt im Vault an. Obsidian zeigt ihn sofort.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ Organizer المجلد مباشرة في الخزنة، ويظهر فورًا في Obsidian."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizer creates the folder directly in the vault. Obsidian shows it immediately."
          }
        }
      }
    },
    "Organizer legt die Datei _Organizer/Roadmap/%@.md an.": {
      "localizations": {
        "ar": {
