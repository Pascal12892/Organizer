    "Organizer braucht einmal deine Erlaubnis, diesen Ordner zu lesen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Organizer إلى إذنك مرة واحدة لقراءة هذا المجلد."
