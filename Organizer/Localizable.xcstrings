      }
    },
    "Die Notiz wurde gleichzeitig außerhalb von Organizer geändert.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير الملاحظة خارج Organizer في الوقت نفسه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note was changed outside Organizer at the same time."
          }
        }
      }
    },
    "Die Notiz wurde in der Zwischenzeit außerhalb von Organizer geändert.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير الملاحظة خارج Organizer في هذه الأثناء."
