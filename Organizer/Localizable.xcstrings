    "Dieser Ordner enthält %lld Dateien. Ist das wirklich dein Vault? Ein kleinerer Ordner lädt viel schneller.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا المجلد على %lld ملفات. هل هو حقًا خزنتك؟ المجلد الأصغر يُحمَّل أسرع بكثير."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder contains %lld files. Is it really your vault? A smaller folder loads much faster."
          }
        }
      }
    },
    "Dieses Jahr": {
      "localizations": {
        "ar": {
          "stringUnit": {
